{
  "name": "scenefinder",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @scenefinder/database generate",
    "db:migrate": "pnpm --filter @scenefinder/database migrate",
    "db:seed": "pnpm --filter @scenefinder/database seed"
  },
  "devDependencies": {
    "turbo": "^2.3.0"
  }
}
